{
	"name": "exide",
	"version": "4.1.0",
	"description": "a web-based XQuery IDE",
	"main": "main.js",
	"directories": {
		"doc": "docs"
	},
	"scripts": {
		"build": "npm run bundle-cm6 && npm run bundle-prettier && node scripts/build.js prepare && node scripts/build.js",
		"build:dev": "npm run bundle-cm6 && npm run bundle-prettier && node scripts/build.js prepare && node scripts/build.js --dev",
		"clean": "node scripts/build.js clean",
		"prepare": "husky",
		"test": "node --test",
		"commitlint": "commitlint --from=HEAD~1",
		"bundle-prettier": "node tools/bundle-prettier.js",
		"bundle-cm6": "node tools/bundle-cm6.js",
		"generate-parser": "node tools/generate-parser.js",
		"generate-parser-40": "node tools/generate-parser.js --grammar grammars/XQuery-40-Family-XQUFEL.ebnf --name XQueryParser40 --output src/parser/XQueryParser40.js",
		"generate-parsers": "npm run generate-parser && npm run generate-parser-40",
		"cypress": "cypress run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eXist-db/eXide.git"
	},
	"keywords": [
		"exist-db",
		"xquery",
		"ide"
	],
	"author": "Wolfgang Meier",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/eXist-db/eXide/issues"
	},
	"homepage": "https://github.com/eXist-db/eXide#readme",
	"devDependencies": {
		"chalk": "^6.0.0",
		"command-line-args": "^6.0.2",
		"cypress": "^16.0.0",
		"esbuild": "^0.28.2",
		"glob-stream": "^8.0.3",
		"request": "^2.88.2",
		"ws": "^8.21.3",
		"yazl": "^3.3.1",
		"husky": "^9.1.7",
		"@commitlint/cli": "^20.3.1",
		"@commitlint/config-conventional": "^20.3.1",
		"@semantic-release/commit-analyzer": "^10.0.0",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@xmldom/xmldom": "^0.9.12",
		"conventional-changelog-conventionalcommits": "^9.0.0",
		"conventional-changelog-writer": "^9.2.1",
		"conventional-commits-parser": "^7.1.2",
		"semantic-release": "^25.0.3"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/legacy-modes": "^6.5.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.4",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.11",
		"@lezer/highlight": "^1.2.1",
		"@prettier/plugin-xml": "^3.4.2",
		"prettier": "^3.9.6",
		"prettier-plugin-xquery": "^1.6.4"
	}
}

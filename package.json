{
	"name": "exide",
	"version": "4.0.1",
	"description": "a web-based XQuery IDE",
	"main": "main.js",
	"directories": {
		"doc": "docs"
	},
	"scripts": {
		"build": "npm run bundle-cm6 && npm run bundle-prettier && node scripts/build.js prepare && node scripts/build.js",
		"build:dev": "npm run bundle-cm6 && npm run bundle-prettier && node scripts/build.js prepare && node scripts/build.js --dev",
		"clean": "node scripts/build.js clean",
		"test": "node --test",
		"bundle-prettier": "node tools/bundle-prettier.js",
		"bundle-cm6": "node tools/bundle-cm6.js",
		"generate-parser": "node tools/generate-parser.js",
		"generate-parser-40": "node tools/generate-parser.js --grammar grammars/XQuery-40-Family-XQUFEL.ebnf --name XQueryParser40 --output src/parser/XQueryParser40.js",
		"generate-parsers": "npm run generate-parser && npm run generate-parser-40",
		"cypress": "cypress run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eXist-db/eXide.git"
	},
	"keywords": [
		"exist-db",
		"xquery",
		"ide"
	],
	"author": "Wolfgang Meier",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/eXist-db/eXide/issues"
	},
	"homepage": "https://github.com/eXist-db/eXide#readme",
	"devDependencies": {
		"chalk": "^4.1.2",
		"command-line-args": "^6.0.2",
		"cypress": "^15.18.1",
		"esbuild": "^0.28.2",
		"glob-stream": "^7.0.0",
		"micro-fs": "^1.0.3",
		"request": "^2.88.2",
		"ws": "^8.21.1"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.4",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.1",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/legacy-modes": "^6.5.2",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.7.1",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.6",
		"@lezer/highlight": "^1.2.1",
		"@prettier/plugin-xml": "^3.4.2",
		"prettier": "^3.9.6",
		"prettier-plugin-xquery": "^1.6.3"
	},
	"overrides": {
		"glob-stream": "$glob-stream"
	}
}

{
	"name": "exide",
	"version": "3.5.5",
	"description": "a web-based XQuery IDE",
	"main": "main.js",
	"directories": {
		"doc": "docs"
	},
	"scripts": {
		"build": "npm run bundle-cm6 && npm run bundle-prettier && node scripts/build.js prepare && node scripts/build.js",
		"build:dev": "npm run bundle-cm6 && npm run bundle-prettier && node scripts/build.js prepare && node scripts/build.js --dev",
		"clean": "node scripts/build.js clean",
		"test": "node --test test/parser-test.js test/visitor-test.js test/utils-test.js test/static-analysis-test.js test/snippet-test.js",
		"bundle-prettier": "node tools/bundle-prettier.js",
		"bundle-cm6": "node tools/bundle-cm6.js",
		"generate-parser": "node tools/generate-parser.js",
		"cypress": "cypress run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eXist-db/eXide.git"
	},
	"keywords": [
		"exist-db",
		"xquery",
		"ide"
	],
	"author": "Wolfgang Meier",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/eXist-db/eXide/issues"
	},
	"homepage": "https://github.com/eXist-db/eXide#readme",
	"devDependencies": {
		"chalk": "^4.1.2",
		"command-line-args": "^6.0.1",
		"cypress": "^15.11.0",
		"esbuild": "^0.27.3",
		"glob-stream": "^7.0.0",
		"micro-fs": "^1.0.3",
		"request": "^2.88.2"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.1",
		"@codemirror/commands": "^6.10.2",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.12.2",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/legacy-modes": "^6.5.2",
		"@codemirror/lint": "^6.9.5",
		"@codemirror/search": "^6.6.0",
		"@codemirror/state": "^6.5.4",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.39.16",
		"@lezer/highlight": "^1.2.1",
		"@prettier/plugin-xml": "^3.4.2",
		"prettier": "^3.8.1",
		"prettier-plugin-xquery": "^1.5.0"
	},
	"overrides": {
		"glob-stream": "$glob-stream"
	}
}

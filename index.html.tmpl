                <span id="toolbar">
                    <span class="toolbar-buttons">
                        <button id="new" title="Create a new untitled editor tab"><i class="fa fa-file-o"></i> New</button>
                        <button id="new-xquery" title="Create a new untitled XQuery editor tab"><i class="fa fa-file-code-o"></i> New XQuery</button>
                        <button id="open" title="Open a resource from eXist-db"><i class="fa fa-folder-open-o"></i> Open</button>
                        <button id="save" title="Save the active editor tab to eXist-db"><i class="fa fa-floppy-o"></i> Save</button>
                        <button id="close" title="Close the active editor tab"><i class="fa fa-times"></i> Close</button>
                        <button id="run" title="Evaluate this query in eXide"><i class="fa fa-play"></i> Run</button>
                        <button id="cancel-query" title="Cancel running query" style="display:none"><i class="fa fa-stop"></i> Cancel</button>
                        <button id="launch" title="Launch this saved query in a new browser tab"><i class="fa fa-external-link"></i> Launch</button>
                    </span>
                    <span class="toolbar-buttons toolbar-buttons-right">
                        <button id="toggle-outline" title="Toggle outline panel"><svg class="toolbar-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="2" width="14" height="12" rx="1.5"/><line x1="5" y1="2" x2="5" y2="14"/></svg></button>
                        <button id="toggle-results" title="Toggle results panel"><svg class="toolbar-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="2" width="14" height="12" rx="1.5"/><line x1="1" y1="10" x2="15" y2="10"/></svg></button>
                        <button id="toggle-monitor" title="Toggle Monitor"><svg class="toolbar-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="2" width="14" height="12" rx="1.5"/><line x1="11" y1="2" x2="11" y2="14"/></svg></button>
                        <button id="toggle-dark-mode" title="Toggle Dark Mode"><i class="fa fa-moon-o"></i></button>
                        <button id="toggle-fullscreen" title="Toggle Fullscreen Mode"><i class="fa fa-arrows-alt"></i></button>

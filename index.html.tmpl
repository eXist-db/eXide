            <div id="body">
                <div id="layout-container">
                    <div class="layout layout-horizontal">
                     <div id="outline-container" class="panel-west">
                            <div id="tabs-outline-container">
                                <ul id="tabs-outline"/>
                                <button id="toggle-split-pane" title="Toggle stacked view" aria-pressed="false">⊟</button>
                            </div>

                            <div id="outline-body">
                                <div id="outline-toolbar">
                                    <button data-outline-mode="nested-doc" title="Nested, document order"><i class="fa fa-indent"/> </button>
                                    <button data-outline-mode="flat-doc" title="Flat, document order"><i class="fa fa-list"/> </button>
                                    <button data-outline-mode="flat-alpha" title="Flat, alphabetical"><i class="fa fa-sort-alpha-asc"/> </button>
                                </div>
                                <div class="panel-scroller">
                                    <ul id="outline"/>
                                </div>
                                <div class="panel-filter">
                                    <input type="search" id="outline-filter" placeholder="Filter outline..."/>
                                </div>
                            </div>
                            <div id="directory-body">
                                <div id="dir-toolbar">
                                    <button id="toggle-dir-view" title="Toggle tree / folder view"><i class="fa fa-folder-open-o"/></button>
                                    <button id="refresh-dir" title="Reload"><i class="fa fa-refresh"/></button>
                                </div>
                                <div id="dir-tree-view">
                                    <div class="panel-scroller">
                                        <div class="tree">
                                            <ul id="directory">
                                                <li id="tree-root"/>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div id="dir-flat-view" style="display:none">
                                    <div id="dir-flat-breadcrumbs" class="dir-breadcrumbs"/>
                                    <div class="panel-scroller">
                                        <ul id="dir-flat-list" class="dir-flat-list"/>
                                    </div>
                                </div>
                                <div class="panel-filter">
                                    <input type="search" id="directory-filter" placeholder="Filter resources..."/>
                                </div>
                            </div>
                            <div class="resize-handle">
                                <span title="Click to close outline"/>
                            </div>
                        </div>

                        <div class="layout-vertical">
                            <div class="main">
                                <div id="tabs-container">
                                    <div id="tab-strip-wrap">
                                        <ul id="tabs">
                                            <li class="drop-placeholder">
                                                <a href="#" class="tab">+</a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div id="tab-controls-wrap">
                                        <div id="tab-controls">
                                            <button id="tab-scroll-left" class="tab-ctrl-btn" title="Scroll tabs left" aria-label="Scroll tabs left" disabled="disabled">&#x2039;</button>
                                            <button id="tab-scroll-right" class="tab-ctrl-btn" title="Scroll tabs right" aria-label="Scroll tabs right">&#x203A;</button>
                                            <button id="tab-list-btn" class="tab-ctrl-btn tab-list-arrow" title="All open files" aria-label="All open files" aria-haspopup="listbox" aria-expanded="false">&#x25BE;</button>
                                        </div>
                                        <ul id="tab-list-menu" role="listbox" aria-label="Open files"></ul>
                                    </div>
                                </div>
                                <div class="content" id="editor"/>
                                <div id="status-bar">
                                    <span id="status">
                                        <span class="path">Path</span>
                                        <button id="status-copy-url" class="status-copy-btn" title="Copy path to clipboard" style="display:none">
                                            <span class="fa fa-clipboard"/>
                                        </button>
                                    </span>
                                    <span class="status-separator">|</span>
                                    <span id="status-cursor">Ln 1, Col 1</span>
                                    <span class="status-separator" id="status-scope-sep" style="display:none">|</span>
                                    <span id="status-scope" style="display:none"></span>
                                    <a href="#" id="error-status"></a>
                                    <span id="exide-err-pill" role="button" tabindex="0" aria-label="Error details">
                                        <span class="fa fa-exclamation-circle"></span>
                                        <span id="exide-err-pill-label"></span>
                                        <span id="exide-err-pill-arrow"></span>
                                    </span>
                                    <span class="status-right" id="status-db-version"></span>
                                    <span class="status-segment" id="status-app" title="Current application">
                                        <span class="status-segment-label">APP</span>
                                        <img id="toolbar-current-app-icon" class="status-app-icon" style="display:none" alt="" />
                                        <a id="toolbar-current-app-link" class="status-segment-value unknown" target="_blank" rel="noopener">
                                            <span id="toolbar-current-app">unknown</span>
                                        </a>
                                    </span>
                                    <span class="status-segment status-segment-clickable" id="status-type" title="File type — click to change">
                                        <span class="status-segment-label">TYPE</span>
                                        <span class="status-segment-value" id="status-type-value">XQuery</span>
                                        <span class="status-segment-arrow">&#x25B2;</span>
                                    </span>
                                    <div id="type-popover">
                                        <div class="type-popover-item" data-value="css">CSS</div>
                                        <div class="type-popover-item" data-value="html">HTML</div>
                                        <div class="type-popover-item" data-value="javascript">Javascript</div>
                                        <div class="type-popover-item" data-value="json">JSON</div>
                                        <div class="type-popover-item" data-value="less">Less</div>
                                        <div class="type-popover-item" data-value="markdown">Markdown</div>
                                        <div class="type-popover-item" data-value="text">Text</div>
                                        <div class="type-popover-item" data-value="xml">XML</div>
                                        <div class="type-popover-item" data-value="xquery">XQuery</div>
                                    </div>
                                </div>
                                <div id="exide-err-panel">
                                    <div id="exide-err-panel-body"></div>
                                    <button id="exide-err-panel-copy" aria-label="Copy error" title="Copy error to clipboard">
                                        <span class="fa fa-clipboard"></span>
                                    </button>
                                    <button id="exide-err-panel-close" aria-label="Close error panel">&#215;</button>
                                </div>
                                <div id="ext-status-bar"/>
                            </div>
                            <div class="panel-south results-container">
                                <div class="resize-handle">
                                    <span title="Click to close results"/>
                                </div>
                                <div class="navbar">
                                    <div class="navbar-left">
                                        <select name="output-mode" id="serialization-mode" title="Serialization method">
                                            <option value="adaptive">Adaptive</option>
                                            <option value="json">JSON</option>
                                            <option value="text">Text</option>
                                            <option value="xml">XML</option>
                                            <option value="html5">HTML5</option>
                                            <option value="xhtml">XHTML</option>
                                            <option value="xhtml5">XHTML5</option>
                                            <option value="microxml">MicroXML</option>
                                            <option disabled="disabled">-</option>
                                            <option value="direct">Direct</option>
                                        </select>
                                        <a class="toggle-btn active" id="indent-results-btn" href="#" title="Indent results (effective in Adaptive, JSON, (X)HTML, and XML Output modes)">
                                            <i class="fa fa-indent" aria-hidden="true"></i>
                                            <input type="checkbox" id="indent-results" name="indent-results" checked="checked" style="display:none"/>
                                        </a>
                                        <a class="toggle-btn active" id="auto-expand-btn" href="#" title="Highlight Index Matches: highlight hits from index-based queries (e.g., Lucene full text, Range)">
                                            <i class="fa fa-lightbulb-o" aria-hidden="true"></i>
                                            <input type="checkbox" id="auto-expand-matches" name="auto-expand-matches" checked="checked" style="display:none"/>
                                        </a>
                                    </div>
                                    <div class="navbar-center">
                                        <a class="toggle-btn first-page" href="#" title="First page">
                                            <i class="fa fa-chevron-left" aria-hidden="true"></i><i class="fa fa-chevron-left nav-double" aria-hidden="true"></i>
                                        </a>
                                        <a class="toggle-btn previous" href="#" title="Previous page">
                                            <i class="fa fa-chevron-left" aria-hidden="true"></i>
                                        </a>
                                        <a class="toggle-btn result-prev" href="#" title="Previous result">
                                            <i class="fa fa-chevron-up" aria-hidden="true"></i>
                                        </a>
                                        <span class="current"/>
                                        <a class="toggle-btn result-next" href="#" title="Next result">
                                            <i class="fa fa-chevron-down" aria-hidden="true"></i>
                                        </a>
                                        <a class="toggle-btn next" href="#" title="Next page">
                                            <i class="fa fa-chevron-right" aria-hidden="true"></i>
                                        </a>
                                        <a class="toggle-btn last-page" href="#" title="Last page">
                                            <i class="fa fa-chevron-right" aria-hidden="true"></i><i class="fa fa-chevron-right nav-double" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                    <div class="navbar-right">
                                        <select id="number-of-results" title="Number of results per page">
                                            <option value="10" selected="selected">10</option>
                                            <option value="25">25</option>
                                            <option value="50">50</option>
                                            <option value="100">100</option>
                                        </select>
                                        <a class="toggle-btn" id="live-preview-btn" href="#" title="Live Preview: auto-update results while typing XQuery or saving HTML">
                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                            <input type="checkbox" id="live-preview" name="live-preview" style="display:none"/>
                                        </a>
                                        <a class="toggle-btn" id="copy-all-clipboard" href="#" title="Copy all displayed results to clipboard">
                                            <i class="fa fa-clipboard" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </div>
                                <div id="query-timing" class="query-timing" style="display:none"></div>
                                <div id="results-body">
                                    <div class="marker-layer">

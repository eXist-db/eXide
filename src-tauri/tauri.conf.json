{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eXide Desktop",
  "version": "0.1.0",
  "identifier": "org.exist-db.eXide-desktop",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:8080/exist/apps/eXide",
    "beforeBuildCommand": "npm run build:desktop-assets"
  },
  "app": {
    "windows": [
      {
        "title": "eXide Desktop",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
